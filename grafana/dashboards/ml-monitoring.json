{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "ssa-ml-monitoring",
  "title": "Stock Sentiment — ML monitoring",
  "tags": ["ssa", "phase6", "drift"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 10,
      "title": "Prediction distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (sentiment) (predictions_total)",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "showLegend": true, "placement": "right" }
      }
    },
    {
      "id": 11,
      "title": "Model currently serving",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "model_version_info",
          "legendFormat": "v{{version}} ({{stage}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] }
        }
      }
    },
    {
      "id": 12,
      "title": "Feedback volume (by label)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum by (label) (increase(feedback_received_total[1h]))",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Numeric feature drift (KS p-value)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "feature_drift_pvalue",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 0.05 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "min": 0, "max": 1
        }
      }
    },
    {
      "id": 14,
      "title": "Categorical drift (JS divergence)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "feature_drift_jsd",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 0.1 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 15,
      "title": "Drift detected (any signal)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "targets": [
        {
          "expr": "max(drift_detected{type=\"any\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "clean",  "color": "green" } }, "type": "value" },
            { "options": { "1": { "text": "drift!", "color": "red"   } }, "type": "value" }
          ]
        }
      }
    },
    {
      "id": 16,
      "title": "Drift job age (seconds since last run)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "expr": "time() - drift_last_run_timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red",    "value": 7200 }
            ]
          }
        }
      }
    }
  ]
}
